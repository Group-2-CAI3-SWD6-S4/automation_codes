package Pages_pkg;

import org.openqa.selenium.*;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import java.time.Duration;
import java.util.List;

public class ProductPage {
    WebDriver driver ;
    public ProductPage(WebDriver driver) {
        this.driver=driver;
    }

    private By SearchTextField       = By.xpath("//input[@name='search']");//el makan ely basearch mno
    private By SearchBoutton         = By.xpath("//button[@id='submit_search']");
    private By searchedProductsTitle = By.xpath("//h2[text()='Searched Products']");//"search product" word

    private By firstProduct  = By.xpath("//a[@data-product-id='1']");
    private By secondproduct = By.xpath("//a[@data-product-id='2']");

    private By ContinueButton = By.xpath("//button[@data-dismiss='modal']");
    private By CartBottun     = By.xpath("//a[@href='/view_cart']");

    private By CenterText   = By.xpath("//div[@class='features_items']/h2");//tc9 used to get the center text

    private By productTitles = By.xpath("//div[@class='productinfo text-center']/p");
    private By addToCartButtons = By.xpath("//div[@class='productinfo text-center']//a[contains(text(),'Add to cart')]");
    private By continueShoppingBtn = By.xpath("//button[contains(text(),'Continue Shopping')]");

    public String GetProductOneId(){
        String id = driver.findElement(firstProduct).getAttribute("data-product-id");
        return id;
    }
    public String GetProductTwoId(){
        String id = driver.findElement(secondproduct).getAttribute("data-product-id");
        return id;
    }


    public boolean verifyProductsContain(String keyword) {
        List<WebElement> products = driver.findElements(productTitles);

        for (WebElement product : products) {
            String name = product.getText().toLowerCase();
            if (!name.contains(keyword.toLowerCase())) {
                return false; // some product does NOT match
            }
        }

        return true; // all products matched
    }


    public void addAllProductsToCart() {

        JavascriptExecutor js = (JavascriptExecutor) driver;
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

        // remove ad iframes
        js.executeScript("document.querySelectorAll('iframe[id^=\"aswift\"]').forEach(e => e.remove());");

        List<WebElement> addButtons = driver.findElements(addToCartButtons);

        for (WebElement btn : addButtons) {

            // scroll to button to avoid overlay issues
            js.executeScript("arguments[0].scrollIntoView(true);", btn);

            // click Add to cart
            btn.click();

            // wait for popup to appear
            wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("cartModal")));

            // click Continue Shopping
            wait.until(ExpectedConditions.elementToBeClickable(continueShoppingBtn)).click();

            // wait for popup to disappear
            wait.until(ExpectedConditions.invisibilityOfElementLocated(By.id("cartModal")));
        }
    }




    // Locator for the second product name

    By secondProductNameLocator = By.xpath("(//div[@class='product-image-wrapper'])[2]//p");
    By secondProductLocator      = By.xpath("(//div[@class='product-image-wrapper'])[2]");


    // Get the name and save it in a string
    public String getSecondProductName() {

        JavascriptExecutor js = (JavascriptExecutor) driver;
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

        // 1. Remove sticky banner ads
        js.executeScript(
                "document.querySelectorAll('*').forEach(el => {" +
                        "  const s = getComputedStyle(el);" +
                        "  if (s.position === 'fixed' && parseInt(s.bottom) === 0) el.remove();" +
                        "});"
        );

        // Remove iframe ads + any element with 'ad' in id/class
        js.executeScript(
                "document.querySelectorAll('iframe, [id*=\"ad\"], [class*=\"ad\"]').forEach(e => e.remove());"
        );

        // 2. Scroll to load products
        js.executeScript("window.scrollBy(0, 200);");
        js.executeScript("window.scrollBy(0, 100);");

        // 3. Wait for 2nd product name to appear
        WebElement productName = wait.until(
                ExpectedConditions.visibilityOfElementLocated(secondProductNameLocator)
        );

        // 4. Scroll into view
        js.executeScript("arguments[0].scrollIntoView(true);", productName);

        // 5. Click the product safely with JS
        WebElement productToClick = wait.until(
                ExpectedConditions.elementToBeClickable(secondProductLocator)
        );
        js.executeScript("arguments[0].click();", productToClick);

        // 6. Return its name
        return productName.getText();
    }


    //    private
    public boolean CheckAllProductAppear(){//tc9
        String text = driver.findElement(CenterText).getText();
        return text.contains("ALL PRODUCTS");
    }
    public boolean CheckSearchProductAppear(){//tc9
        String text = driver.findElement(CenterText).getText();
        return text.contains("SEARCHED PRODUCTS");
    }

public ItemPage ClickOnViewItem() {
    JavascriptExecutor js = (JavascriptExecutor) driver;

    // 1. Remove ads
    js.executeScript("document.querySelectorAll('iframe[id^=\"aswift\"]').forEach(e => e.remove());");

    // 2. Scroll so products load
    js.executeScript("window.scrollBy(0, 800);");

    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

    // 3. Click the FIRST "View Product" button
    WebElement viewProduct = wait.until(
            ExpectedConditions.visibilityOfElementLocated(
                    By.xpath("(//a[contains(text(),'View Product')])[1]")
            )
    );

    // 4. Scroll into view
    js.executeScript("arguments[0].scrollIntoView(true);", viewProduct);

    // 5. Safe click (JS click avoids ads)
    js.executeScript("arguments[0].click();", viewProduct);

    // 6. Return item page
    return new ItemPage(driver);
}

    public void ClickOnFirstItem(){
        driver.findElement(firstProduct).click();
    };

    public void ClickOnSecondItem(){
        driver.findElement(secondproduct).click();
    }
    public void ClickContinueButton(){
        driver.findElement(ContinueButton).click();
    }
    public CartPage ClickCartBottun(){
        driver.findElement(CartBottun).click();
        return new CartPage(driver);
    }


    public void ClickSearchButton(){
        driver.findElement(SearchBoutton).click();
    }
    public void InsertProduct(String product){
        driver.findElement(SearchTextField).sendKeys(product);
    }
    public boolean isSearchedProductsTitleVisible() {
        return driver.findElement(searchedProductsTitle).isDisplayed();
    }
}
