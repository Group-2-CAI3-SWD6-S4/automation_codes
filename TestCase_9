package TestCase_9_pkg;

import Pages_pkg.ProductsPage;
import base_pkg.base_class;
import org.testng.Assert;
import org.testng.annotations.Test;

public class TestCase_9 extends base_class {
    @Test
    public void SearchProduct(){
        boolean isHomeVisible = homePage.verifyHomePage();
        Assert.assertTrue(isHomeVisible, "Home page is not visible!");
        ProductsPage productsPage = homePage.ClickOnProductLink();
        Assert.assertTrue(productsPage.CheckAllProductAppear());
        productsPage.InsertProduct("b");
        productsPage.ClickSearchButton();
        Assert.assertTrue(productsPage.CheckSearchProductAppear());
        Assert.assertTrue(productsPage.isSearchedProductsTitleVisible());
        Assert.assertTrue(productsPage.verifyProductsContain("b"));

    }

}
