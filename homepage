package Pages_pkg;

import org.openqa.selenium.*;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import java.time.Duration;

public class HomePage_class {
    public WebDriver driver;

    public HomePage_class(WebDriver driver) {
        this.driver = driver;
    }


    private By UserName(String name) {
        return By.xpath("//b[contains(text(),'" + name + "')]");
    }

    private By DeleteButton = By.xpath("//a[@href='/delete_account']");
    private By accountDeletedText = By.xpath("//h2[@class='title text-center']");

    private By loginTextPlusUsername = By.xpath("//a[contains(text(),' Logged in as ')]");
    private By ClickOnLogin = By.xpath("//a[@href='/login']");
    private By ClickOnLogout = By.xpath("//a[@href='/logout']");
    private By ClickOnContactUs = By.xpath("//a[@href='/contact_us']");
    private By CartViewLink = By.xpath("//a[@href='/view_cart']");
    private By viewCartInModal = By.xpath("//p[@class='text-center']//a[@href='/view_cart']");

    private By CartBottun = By.xpath("//a[@href='/view_cart']");
    private By ProductsLink = By.xpath("//a[@href='/products']");
    private By TestCasesButton = By.xpath("//button[@type='button']");
    private By statescase = By.xpath("//a[@href='/logout']");
    private By Subscription = By.xpath("//h2[normalize-space()='Subscription']");
    private By Full_Felged = By.xpath("//h2[normalize-space()='Full-Fledged practice website for Automation Engineers']");
    private By Email = By.xpath("//input[@type='email']");
    private By submitButton = By.xpath("//button[@type='submit']");
    private By successMsg = By.xpath("//div[contains(text(),'You have been successfully subscribed!')]");
    private By Recommendation = By.xpath("//h2[contains(text(), 'recommended items')]");

    private By firstProduct = By.xpath("//a[@data-product-id='1']");
    private By SecondProduct = By.xpath("//a[@data-product-id='2']");
    private By thirdProduct = By.xpath("//a[@data-product-id='3']");



    public String AddFirstProductInRecommendation() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(3));
        WebElement msg = wait.until(ExpectedConditions.visibilityOfElementLocated(firstProduct));
        driver.findElement(firstProduct).click();
        String name = driver.findElement(By.xpath("//p[contains(text(),'Blue Top')]")).getText();
        return name;
    }

    public String GetProductOneId(){
        String id = driver.findElement(firstProduct).getAttribute("data-product-id");
        return id;
    }
    public String GetProductTwoId(){
        String id = driver.findElement(SecondProduct).getAttribute("data-product-id");
        return id;
    }


    public void AddProductOne (){
        JavascriptExecutor js = (JavascriptExecutor) driver;
        js.executeScript("document.querySelectorAll('iframe[id^=\"aswift\"]').forEach(e => e.remove());");
        WebElement button = driver.findElement(firstProduct);
        js.executeScript("arguments[0].scrollIntoView(true);", button);

        driver.findElement(firstProduct).click();
    }

    public void AddProductTwo(){
        JavascriptExecutor js = (JavascriptExecutor) driver;
        js.executeScript("document.querySelectorAll('iframe[id^=\"aswift\"]').forEach(e => e.remove());");
        WebElement button = driver.findElement(SecondProduct);
        js.executeScript("arguments[0].scrollIntoView(true);", button);
        driver.findElement(SecondProduct).click();
    }
    public void AddProductThree(){
        driver.findElement(thirdProduct).click();
    }

    public CartPage clickViewCartFromModal() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));
        WebElement modalViewCart = wait.until(ExpectedConditions.elementToBeClickable(viewCartInModal));
        modalViewCart.click();
        return new CartPage(driver);
    }
    public boolean IsvisibleloginTextPlusUsername(){
        return driver.findElement(loginTextPlusUsername).isDisplayed();
    }

    public boolean CheckUserName(String username){
       return driver.findElement(UserName(username)).isDisplayed();
    }

    public void scrollToRecommendedItems() throws InterruptedException {
        JavascriptExecutor js = (JavascriptExecutor) driver;

        // Scroll to bottom (required for this website)
        js.executeScript("window.scrollTo(0, document.body.scrollHeight)");
        Thread.sleep(1500);

        // Bring Recommended section to center
        WebElement rec = driver.findElement(Recommendation);
        js.executeScript("arguments[0].scrollIntoView({block:'center'});", rec);
        Thread.sleep(700);
    }

    public void clickRecommendedAddToCart() throws InterruptedException {
        JavascriptExecutor js = (JavascriptExecutor) driver;
        js.executeScript("document.querySelectorAll('iframe[id^=\"aswift\"]').forEach(e => e.remove());");
        WebElement button = driver.findElement(By.xpath("//a[@data-product-id='1']"));
        js.executeScript("arguments[0].scrollIntoView(true);", button);

    }
    public ContactUsPage ClickOnClickOnContactUs(){
        driver.findElement(ClickOnContactUs).click();
        return new ContactUsPage(driver);
    }

    public boolean isRecommendationVisible() {
        return driver.findElement(Recommendation).isDisplayed();
    }


    public boolean isSuccessfullySubscribedVisible() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(3));
        WebElement msg = wait.until(ExpectedConditions.visibilityOfElementLocated(successMsg));
        return msg.isDisplayed();
    }


    public void InsertEmail(String email){
        driver.findElement(Email).sendKeys(email);
    }

    public void ClickSubmitButton(){
        driver.findElement(submitButton).click();
    }



    public void ScrollDownToBottom() {
        JavascriptExecutor js = (JavascriptExecutor) driver;
        js.executeScript("window.scrollTo(0, document.body.scrollHeight)");
    }

    public void ScrollUpToTop() {
        JavascriptExecutor js = (JavascriptExecutor) driver;
        js.executeScript("window.scrollTo(0, 0)");
    }

    public boolean scrollDownUntilSubscriptionVisible() {
        WebElement body = driver.findElement(By.tagName("body"));
        for (int i = 0; i < 20; i++) {
            body.sendKeys(Keys.ARROW_DOWN);
            if (this.isSubscriptionVisible()) {
                return true;
            }
        }
        return false;
    }

    public boolean scrollUPUntilFull_FelgedVisible() {
        WebElement body = driver.findElement(By.tagName("body"));
        for (int i = 0; i < 20; i++) {
            body.sendKeys(Keys.ARROW_UP);
            if (this.isSubscriptionVisible()) {
                return true;
            }
        }
        return false;
    }

    public boolean isSubscriptionVisible() {
        return driver.findElement(Subscription).isDisplayed();
    }

    public boolean isFullFledgedTextVisible() {
        return driver.findElement(Full_Felged).isDisplayed();
    }

    public boolean chechSiteStatus(String status){
        String actual = driver.findElement(statescase).getText();
        return actual.contains(status);
    }

    public TestCasesPage ClickOnTestCasesButton(){
        driver.findElement(TestCasesButton).click();
        return new TestCasesPage(driver);
    }

    public ProductPage ClickOnProductLink(){
        driver.findElement(ProductsLink).click();
        return new ProductPage(driver);
    }


    public CartPage ClickOnCartLink (){
        driver.findElement(CartViewLink).click();
        return new CartPage(driver);
    }

    public CartPage ClickOnCartBottun (){
        driver.findElement(CartBottun).click();
        return new CartPage(driver);
    }

    public LoginPage ClickOnLoginButton(){
        driver.findElement(ClickOnLogin).click();
        return new LoginPage(driver);
    }
    public LoginPage ClickOnLogoutButton(){
        driver.findElement(ClickOnLogout).click();
        return new LoginPage(driver);
    }
    public boolean CheckaccountDeletedText(){
        String actual = driver.findElement(accountDeletedText).getText();
        return actual.contains("ACCOUNT DELETED!");
    }
    public void ClickDeleteButton(){
        driver.findElement(DeleteButton).click();
    }
}
