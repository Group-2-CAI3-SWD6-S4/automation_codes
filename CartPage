package Pages_pkg;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import java.time.Duration;
import java.util.List;

public class CartPage {
    WebDriver driver ;
    public CartPage(WebDriver driver) {
        this.driver=driver;
    }

    private By qtyForProduct(String productName) {
        return By.xpath("//h2[text()='" + productName + "']/ancestor::div[@class='product-information']//input[@id='quantity']");
    }
    private By productById(String id) {
        return By.xpath("//a[@data-product-id='" + id + "']");
    }

    private By CartTable = By.xpath("//div[@class='table-responsive cart_info']");
    private By SubscriptionText = By.xpath("//h2[normalize-space()='Subscription']");
    private By EmailTextField = By.xpath("//input[@type='email']");
    private By submitButton = By.xpath("//button[@type='submit']");

    private By successText = By.xpath("//div[contains(text(),'You have been successfully subscribed!')]");
    private By ShoppingCartText = By.xpath("//li[@class='active']");
    private By emptycartText = By.xpath("//span[@id='empty_cart']//P[@class='text-center']");
    private By addressDetailsText = By.xpath("//h2[text()='Address Details']");
    private By ProceedButton = By.xpath("//a[@class='btn btn-default check_out']");
    private By placeOrderButton = By.xpath("//a[text()='Place Order']");
    private By RegisterLoginButton = By.xpath("//p[@class='text-center']//a[@href='/login']");
    private By RegisterLoginButtonn = By.xpath("//a[@href='/login']");
    private By commentBox = By.name("message");
    private By registerLoginLink = By.xpath("//a[.//u[text()='Register / Login']]");

    private By searchResults = By.cssSelector(".productinfo p");
    private By quantityBtn = By.xpath("//td[@class='cart_quantity']/button");

    public int getQuantity() {
        String qtyText = driver.findElement(quantityBtn).getText();
        return Integer.parseInt(qtyText);
    }

    public String getAddressDetailsText(){
        String message = driver.findElement(addressDetailsText).getText();
        return message;
    }

    public PaymentPage clickPlaceOrderButton(){
        driver.findElement(placeOrderButton).click();
        return new PaymentPage(driver);
    }


    public void DeleteById(String id ){
        driver.findElement(productById(id)).click();
    }
    public boolean CartIsEmpty(){
        return driver.findElement(emptycartText).isDisplayed();
    }

    public boolean verifyProductsContain(String keyword) {
        List<WebElement> products = driver.findElements(searchResults);

        for (WebElement product : products) {
            String name = product.getText().toLowerCase();
            if (!name.contains(keyword.toLowerCase())) {
                return false; // some product does NOT match
            }
        }

        return true; // all products matched
    }

    public boolean CheckVisiblityOfProduct(String product){
        String actual = driver.findElement(CartTable).getText();
        return actual.contains(product);
    }

    public LoginPage ClickRegisterLoginButton(){
        driver.findElement(RegisterLoginButton).click();
        return new LoginPage((driver));
    }
    public LoginPage ClickRegisterLoginButtonn(){
        driver.findElement(RegisterLoginButtonn).click();
        return new LoginPage((driver));
    }

    public LoginPage clickRegisterLoginLink(){
        driver.findElement(registerLoginLink).click();
        return new LoginPage(driver);
    }

    public CheckoutPage ClickProceedButton(){
        driver.findElement(ProceedButton).click();
        return new CheckoutPage(driver);
    }

    public void InsertEmail(String email){
        driver.findElement(EmailTextField).sendKeys(email);
    }
    public void ClickSubmitButton(){
        driver.findElement(submitButton).click();
    }
    public boolean ChechShoppingCartTextIsVisible(){
        String actual = driver.findElement(ShoppingCartText).getText();
    return actual.contains("Shopping Cart");
    }

    public boolean SubscriptionTextIsVisible() {
        return driver.findElement(SubscriptionText).isDisplayed();
    }
    public void insertCommentText(String comment){
        driver.findElement(commentBox).sendKeys(comment);
    }

    public boolean scrollDownUntilSubscriptionVisible() {
        WebElement body = driver.findElement(By.tagName("body"));

        for (int i = 0; i < 20; i++) {
            body.sendKeys(Keys.ARROW_DOWN);
            if (this.SubscriptionTextIsVisible()) {
                return true;
            }
        }
        return false;
    }
    public boolean isSuccessfullySubscribedVisible() {
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(3));
        WebElement msg = wait.until(ExpectedConditions.visibilityOfElementLocated(successText)
        );
        return msg.isDisplayed();
    }

}
