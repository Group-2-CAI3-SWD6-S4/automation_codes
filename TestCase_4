package TestCase_4_pkg;

import Pages_pkg.LoginPage;
import base_pkg.base_class;
import org.testng.Assert;
import org.testng.annotations.Test;

public class TestCase_4 extends base_class {
    @Test
    public void LogoutUser(){
        String password ="admin123";
        String email    = "Depiiiii@gmail.com";
        boolean isHomeVisible = homePage.verifyHomePage();
        Assert.assertTrue(isHomeVisible, "Home page is not visible!");
        LoginPage loginPage = homePage.ClickOnLoginButton();
        Assert.assertTrue(loginPage.CheckLoginText());
        loginPage.InsertLoginEmail(email);
        loginPage.InsertLoginPassword(password);
        homePage = loginPage.ClickLoginButton();

        Assert.assertTrue(homePage.IsvisibleloginTextPlusUsername());

        loginPage = homePage.ClickOnLogoutButton();
        Assert.assertTrue(loginPage.CheckLoginText());
    }
}
