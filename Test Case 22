package AddtocartfromRecommendeditems_pkg;

import Pages_pkg.CartPage;
import base_pkg.base_class;
import org.testng.Assert;
import org.testng.annotations.Test;

public class AddtocartfromRecommendeditems extends base_class {

    @Test
    public void verifyRecommendedItemsAndAddToCart() throws InterruptedException {
//verify homepage is displayed
        boolean isHomeVisible = homePage.verifyHomePage();
        Assert.assertTrue(isHomeVisible, "Home page is not visible!");

        homePage.scrollToRecommendedItems();

        Assert.assertTrue(
                homePage.isRecommendationVisible());

        String AddedProduct = homePage.AddFirstProductInRecommendation();

        CartPage cartPage = homePage.clickViewCartFromModal();
        Assert.assertTrue(cartPage.CheckvisiblityOfProduct(AddedProduct));


    }
}
